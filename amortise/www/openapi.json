{
  "openapi": "3.1.0",
  "info": {
    "title": "Loan amortisation",
    "version": "1.0.0",
    "summary": "Monthly repayment schedules calculated in COBOL.",
    "description": "A JSON front end to AMORTCALC, a GnuCOBOL program doing exact fixed-point decimal arithmetic. Each schema property is annotated with x-cobol: the copybook field it comes from and that field's PICTURE. Amounts are JSON strings because their COBOL fields are exact decimals (9(9)V99), which a JSON number would turn into a binary float for most consumers."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/cgi-bin/amortise-api": {
      "get": {
        "operationId": "amortiseLoan",
        "summary": "Calculate a loan's monthly repayment schedule",
        "description": "Uses the standard annuity formula with the monthly rate rounded to 15 decimals and every amount rounded half up to cents. The final payment settles the remaining balance, so the schedule always closes at exactly 0.00.",
        "parameters": [
          {
            "name": "principal",
            "in": "query",
            "required": true,
            "description": "Amount borrowed: 0.01 to 999999999.99, at most 2 decimals.",
            "schema": { "type": "string", "pattern": "^[0-9]{1,9}(\\.[0-9]{1,2})?$", "examples": ["250000"] },
            "x-cobol": { "field": "AR-PRINCIPAL-TEXT", "picture": "X(20)", "copybook": "amortreq.cpy" }
          },
          {
            "name": "rate",
            "in": "query",
            "required": true,
            "description": "Annual interest rate as a percentage: 0 to 100, at most 4 decimals.",
            "schema": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,4})?$", "examples": ["11.75"] },
            "x-cobol": { "field": "AR-RATE-TEXT", "picture": "X(20)", "copybook": "amortreq.cpy" }
          },
          {
            "name": "term",
            "in": "query",
            "required": true,
            "description": "Term in whole months: 1 to 600.",
            "schema": { "type": "string", "pattern": "^[0-9]{1,3}$", "examples": ["240"] },
            "x-cobol": { "field": "AR-TERM-TEXT", "picture": "X(20)", "copybook": "amortreq.cpy" }
          }
        ],
        "responses": {
          "200": {
            "description": "The schedule.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Amortisation" } } }
          },
          "400": {
            "description": "A parameter is missing or invalid. Validation stops at the first bad parameter, checked in the order principal, rate, term.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "405": {
            "description": "A method other than GET.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Amount": {
        "type": "string",
        "description": "An exact decimal amount with two decimal places.",
        "pattern": "^[0-9]+\\.[0-9]{2}$",
        "examples": ["2709.27"]
      },
      "Amortisation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["loan", "payment", "totalInterest", "totalPaid", "schedule"],
        "properties": {
          "loan": {
            "type": "object",
            "description": "The validated inputs.",
            "additionalProperties": false,
            "required": ["principal", "annualRate", "termMonths"],
            "properties": {
              "principal": {
                "$ref": "#/components/schemas/Amount",
                "x-cobol": { "field": "AS-PRINCIPAL", "picture": "9(9)V99", "copybook": "amortres.cpy" }
              },
              "annualRate": {
                "type": "string",
                "description": "Annual percentage rate with four decimal places.",
                "pattern": "^[0-9]{1,3}\\.[0-9]{4}$",
                "examples": ["11.7500"],
                "x-cobol": { "field": "AS-ANNUAL-RATE", "picture": "9(3)V9(4)", "copybook": "amortres.cpy" }
              },
              "termMonths": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600,
                "x-cobol": { "field": "AS-TERM-MONTHS", "picture": "9(3)", "copybook": "amortres.cpy" }
              }
            }
          },
          "payment": {
            "$ref": "#/components/schemas/Amount",
            "description": "The regular monthly payment. The final payment may differ by the rounding carried through the schedule.",
            "x-cobol": { "field": "AS-PAYMENT", "picture": "9(9)V99", "copybook": "amortres.cpy" }
          },
          "totalInterest": {
            "$ref": "#/components/schemas/Amount",
            "x-cobol": { "field": "AS-TOTAL-INTEREST", "picture": "9(11)V99", "copybook": "amortres.cpy" }
          },
          "totalPaid": {
            "$ref": "#/components/schemas/Amount",
            "x-cobol": { "field": "AS-TOTAL-PAID", "picture": "9(11)V99", "copybook": "amortres.cpy" }
          },
          "schedule": {
            "type": "array",
            "minItems": 1,
            "maxItems": 600,
            "items": { "$ref": "#/components/schemas/Period" },
            "x-cobol": { "field": "AS-ROW", "picture": "OCCURS 600 TIMES", "copybook": "amortres.cpy" }
          }
        }
      },
      "Period": {
        "type": "object",
        "additionalProperties": false,
        "required": ["period", "payment", "interest", "principal", "balance"],
        "properties": {
          "period": { "type": "integer", "minimum": 1, "maximum": 600 },
          "payment": {
            "$ref": "#/components/schemas/Amount",
            "x-cobol": { "field": "AS-ROW-PAYMENT", "picture": "9(10)V99", "copybook": "amortres.cpy" }
          },
          "interest": {
            "$ref": "#/components/schemas/Amount",
            "x-cobol": { "field": "AS-ROW-INTEREST", "picture": "9(9)V99", "copybook": "amortres.cpy" }
          },
          "principal": {
            "$ref": "#/components/schemas/Amount",
            "description": "The part of this payment that repays principal.",
            "x-cobol": { "field": "AS-ROW-PRINCIPAL", "picture": "9(9)V99", "copybook": "amortres.cpy" }
          },
          "balance": {
            "$ref": "#/components/schemas/Amount",
            "description": "Principal still owed after this payment.",
            "x-cobol": { "field": "AS-ROW-BALANCE", "picture": "9(9)V99", "copybook": "amortres.cpy" }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "field", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable and safe to branch on. Maps AMORTCALC's AS-STATUS: 10 invalid_principal, 20 invalid_rate, 30 invalid_term, 40 payment_too_small.",
                "enum": ["invalid_principal", "invalid_rate", "invalid_term", "payment_too_small", "method_not_allowed", "internal_error"],
                "x-cobol": { "field": "AS-STATUS", "picture": "X(2)", "copybook": "amortres.cpy" }
              },
              "field": {
                "type": "string",
                "description": "The parameter at fault, or method for a 405. Empty for internal_error.",
                "enum": ["principal", "rate", "term", "method", ""]
              },
              "message": {
                "type": "string",
                "description": "For people. The wording may change, so don't parse it.",
                "x-cobol": { "field": "AS-MESSAGE", "picture": "X(80)", "copybook": "amortres.cpy" }
              }
            }
          }
        }
      }
    }
  }
}
